@base = http://localhost:3000

### 1. Register user sans infos facultatives
# @name registerReq
POST {{base}}/api/v1/auth/register
Content-Type: application/json

{"courriel": "bobby@gmail.com", "pseudonyme": "Tristesse38", "motDePasse": "bobby123"}
###
@utilisateurId = {{registerReq.response.body.id}}

### 2. Register user avec infos facultatives
