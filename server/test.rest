### Login en tant qu'utilisateur et récupérer le token
# @name loginReq
POST {{base}}/api/v1/auth/login
Content-Type: application/json

{
  "courriel": "bobby@gmail.com", "pseudonyme": "Tristesse38", "motDePasse": "bobby123"
}
###
@authToken = {{loginReq.response.body.token}}
###
GET {{base}}/api/v1/journal
Authorization: Bearer {{authToken}}

### Créer une entrée de journal
POST {{base}}/api/v1/journal
Content-Type: application/json
Authorization: Bearer {{authToken}}

{
    "humeur": 2,
    "energie": 1,
    "sommeil": 3,
    "anxiete": 5,
    "gratitude": "Test"
}

