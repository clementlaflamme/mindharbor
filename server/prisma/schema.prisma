generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

//
// ENUMS
//

enum Role {
  UTILISATEUR
  ADMIN
}

enum VisibiliteProfil {
  PUBLIC
  GROUPES_SEULEMENT
  PRIVE
}

enum NiveauContact {
  PERSONNE
  TOUT_LE_MONDE
}

enum CategorieSignalement {
  INAPPROPRIE
  SPAM
  INQUIETANT
}

enum StatutSignalement {
  EN_ATTENTE
  TRAITE
  REJETE
}

enum CategorieRessource {
  ANXIETE
  SOMMEIL
  RELATIONS
  TRAVAIL
  DEUIL
  HUMEUR
  ENERGIE
}

enum VisibiliteGroupe {
  PUBLIC
  PRIVE
}

enum StatutAdhesion {
  EN_ATTENTE
  ACCEPTEE
  REFUSEE
}

enum RoleGroupe {
  MODERATEUR
  MEMBRE
}

//
// MODELES
//

model Utilisateur {
  id            String   @id @default(uuid())
  courriel      String   @unique
  motDePasse    String

  pseudonyme    String   @unique
  nom           String?
  avatarUrl     String   @default("/public/images/default_avatar.jpg")
  bio           String?

  role              Role              @default(UTILISATEUR)
  visibilite        VisibiliteProfil  @default(PUBLIC)
  niveauContact     NiveauContact     @default(TOUT_LE_MONDE)

  creeLe        DateTime @default(now())
  majLe         DateTime @updatedAt

  entreesJournal  EntreeJournal[]
  favoris         Favori[]
  messagesEnvoyes Message[]   @relation("MessagesEnvoyes")
  messagesRecus   Message[]   @relation("MessagesRecus")
  signalements    Signalement[]
  jetonsRefresh   JetonRefresh[]

  membresGroupes    MembreGroupe[]
  demandesAdhesion  DemandeAdhesion[]
  publications      Publication[]
  commentairesGroupe CommentaireGroup[]

  blocagesEffectues Blocage[]
  blocagesRecus     Blocage[] @relation("BlocagesRecus")
}

model EntreeJournal {
  id        String   @id @default(uuid())
  utilisateurId String

  humeur    Int
  energie   Int
  sommeil   Int
  anxiete   Int

  gratitude String?

  creeLe    DateTime @default(now())
  majLe     DateTime @updatedAt

  utilisateur Utilisateur @relation(fields: [utilisateurId], references: [id], onDelete: Cascade)
  activites   ActiviteJournal[]

  @@unique([utilisateurId, creeLe])
}

model Activite {
  id    String @id @default(uuid())
  nom   String @unique

  activitesJournal ActiviteJournal[]
}

model ActiviteJournal {
  entreeJournalId String
  activiteId      String

  entreeJournal EntreeJournal @relation(fields: [entreeJournalId], references: [id], onDelete: Cascade)
  activite      Activite      @relation(fields: [activiteId], references: [id], onDelete: Cascade)

  @@id([entreeJournalId, activiteId])
}

model Ressource {
  id        String   @id @default(uuid())
  titre     String
  contenu   String
  url String @unique
  categorie CategorieRessource
  type String
  duree Int
  niveau Int

  creeLe    DateTime @default(now())
  majLe     DateTime @updatedAt

  favoris   Favori[]
}

model Favori {
  utilisateurId String
  ressourceId   String

  utilisateur Utilisateur @relation(fields: [utilisateurId], references: [id], onDelete: Cascade)
  ressource   Ressource   @relation(fields: [ressourceId], references: [id], onDelete: Cascade)

  @@id([utilisateurId, ressourceId])
}

model Message {
  id          String   @id @default(uuid())
  expediteurId String
  destinataireId String
  sujet String
  contenu     String
  lu          Boolean  @default(false)

  creeLe      DateTime @default(now())

  expediteur   Utilisateur @relation("MessagesEnvoyes", fields: [expediteurId], references: [id], onDelete: Cascade)
  destinataire Utilisateur @relation("MessagesRecus", fields: [destinataireId], references: [id], onDelete: Cascade)

  signalements Signalement[]
}

model Blocage {
  id            String @id @default(uuid())
  bloqueurId    String
  bloqueId      String

  bloqueur Utilisateur @relation(fields: [bloqueurId], references: [id], onDelete: Cascade)
  bloque   Utilisateur @relation("BlocagesRecus", fields: [bloqueId], references: [id], onDelete: Cascade)

  @@unique([bloqueurId, bloqueId])
}

model Signalement {
  id          String             @id @default(uuid())
  utilisateurId String
  messageId   String?
  categorie   CategorieSignalement
  statut      StatutSignalement  @default(EN_ATTENTE)

  publicationId String?
  commentaireId    String?

  publication   Publication?    @relation(fields: [publicationId], references: [id], onDelete: Cascade)
  commentaire   CommentaireGroup?  @relation(fields: [commentaireId], references: [id], onDelete: Cascade)

  creeLe      DateTime @default(now())
  majLe       DateTime @updatedAt

  utilisateur Utilisateur @relation(fields: [utilisateurId], references: [id], onDelete: Cascade)
  message     Message?    @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@unique([utilisateurId, messageId])
  @@unique([utilisateurId, publicationId])
  @@unique([utilisateurId, commentaireId])
}

model JetonRefresh {
  id        String   @id @default(uuid())
  utilisateurId String
  token     String   @unique
  invalide  Boolean  @default(false)
  expireLe  DateTime

  utilisateur Utilisateur @relation(fields: [utilisateurId], references: [id], onDelete: Cascade)
}

model Groupe {
  id            String  @id @default(uuid())
  thematique    String
  description   String
  regles        String
  visibilite    VisibiliteGroupe    @default(PUBLIC)
  Creele        DateTime            @default(now())
  majle         DateTime            @updatedAt

  membres       MembreGroupe[]
  demandesAdhesion  DemandeAdhesion[]
  publications  Publication[]
}

model MembreGroupe {
  id        String      @id @default(uuid())
  groupeId  String
  utilisateurId String
  role      RoleGroupe  @default(MEMBRE)
  rejoindreLe   DateTime    @default(now())

  groupe    Groupe      @relation(fields: [groupeId], references: [id], onDelete: Cascade)
  utilisateur   Utilisateur @relation(fields: [utilisateurId], references: [id], onDelete: Cascade)

  @@unique([groupeId, utilisateurId])
}

model DemandeAdhesion {
  id        String      @id @default(uuid())
  groupeId    String
  utilisateurId String
  presentation  String //La presentation requise pour Julie
  statut    StatutAdhesion  @default(EN_ATTENTE)
  creeLe    DateTime        @default(now())
  majLe     DateTime        @updatedAt

  groupe      Groupe  @relation(fields: [groupeId], references: [id], onDelete: Cascade)
  utilisateur   Utilisateur @relation(fields: [utilisateurId], references: [id], onDelete: Cascade)

  @@unique([groupeId, utilisateurId])
}

model Publication {
  id        String  @id @default(uuid())
  groupeId  String
  utilisateurId String
  contenu   String
  creeLe    DateTime        @default(now())
  majLe     DateTime        @updatedAt

  groupe    Groupe  @relation(fields: [groupeId], references: [id], onDelete: Cascade)
  utilisateur   Utilisateur @relation(fields: [utilisateurId], references: [id], onDelete: Cascade)
  commentaires  CommentaireGroup[]
  signalements  Signalement[]
}

model CommentaireGroup {
  id        String      @id @default(uuid())
  publicationId String
  utilisateurId String
  contenu   String
  CreeLe    DateTime    @default(now())

  publication   Publication @relation(fields: [publicationId], references: [id], onDelete: Cascade)
  auteur        Utilisateur @relation(fields: [utilisateurId], references: [id], onDelete: Cascade)
  signalments   Signalement[]
}